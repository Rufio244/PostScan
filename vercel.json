{
  "buildCommand": "pip install -r requirements.txt",
  "devCommand": "uvicorn app:app --host 0.0.0.0 --port 8000",
  "installCommand": "pip install -r requirements.txt",
  "framework": null,
  "outputDirectory": ".",
  "routes": [
    {"src": "/api/(.*)", "dest": "app.py"},
    {"src": "/(.*)", "dest": "/index.html"}
  ]
}

